# Rift ERP Backend Configuration

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=super-secret-rift-jwt-key

# ==============================================================================
# DATABASE CONFIGURATION (Plug-and-play toggle: 'sqlite' | 'postgres')
# ==============================================================================

# Current active driver:
DB_TYPE=sqlite

# --- Option A: SQLite (Local zero-config file database) ---
SQLITE_PATH=./data/rift.sqlite

# --- Option B: Cloud/External PostgreSQL (Supabase / Neon / RDS / Render) ---
# To switch to Postgres, set DB_TYPE=postgres and provide connection string or host info:
# DATABASE_URL=postgresql://user:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=rift_erp
# DB_SSL=true
