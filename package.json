{
  "name": "rift-erp-monorepo",
  "version": "2.0.0",
  "description": "Rift Restaurant ERP - Pluggable Battery Architecture (Django pattern in Next.js & TypeScript)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "clean": "npm --prefix frontend run clean",
    "seed": "npm --prefix backend run seed",
    "clean:users": "npm --prefix backend run clean:users",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "erp",
    "restaurant",
    "nextjs",
    "typescript",
    "django-pattern",
    "pluggable-apps"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
